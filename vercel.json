{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite"
    },
    "studio": {
      "root": "portfolio-itom",
      "framework": "sanity"
    }
  },
  "rewrites": [
    {
      "source": "/studio/(.*)",
      "destination": {
        "service": "studio"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
